package components

templ SimplePage() {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>TripleWorks Simple Editor</title>
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/@tabler/core@1.6.1/dist/css/tabler.min.css"
		/>
		<script src="https://unpkg.com/htmx.org@4.0.0"></script>
	</head>
	<body>
		<div class="container-xl mt3">
			<h1 class="h2 mb-3">Simple object creator</h1>
			<div id="status-bar">Idle</div>
			<div class="mb-3">
				<label class="form-label" for="model-selection">Model</label>
				<div hx-get="/models" hx-trigger="load"></div>
			</div>
			@LineCard()
			@SubstationCard()
		</div>
		@PageScript()
	</body>
}

templ LineCard() {
	<div class="card mb-3">
		<div class="card-header">
			<div class="card-title">New Line</div>
		</div>
		<div class="card-body">
			<form id="line-form">
				<div class="mb-3">
					<label class="form-label" for="from-input">From substation</label>
					<input type="text" class="form-control" id="from-input" name="from" required/>
				</div>
				<div class="mb-3">
					<label class="form-label" for="to-input">To substation</label>
					<input type="text" class="form-control" id="to-input" name="to" required/>
				</div>
				<div class="mb-3">
					<label class="form-label" for="length-input">Length (km)</label>
					<input type="number" class="form-control" id="length-input" name="length" required/>
				</div>
				<div class="mb-3">
					<label class="form-label" for="voltage-input">Voltage (kV)</label>
					<input type="number" class="form-control" id="voltage-input" name="voltage" required/>
				</div>
				<button id="submit-line" class="btn btn-primary w-100" type="submit">Submit</button>
			</form>
			<hr/>
			<label class="form-label" for="line-file">Upload many from file</label>
			<input type="file" id="line-file" class="form-control" accept=".jsonl,.ndjson"/>
			<div class="form-hint">
				One JSON record per line, e.g.
				<code>{`{"from":"Substation A","to":"Substation B","length":10,"voltage":400}`}</code>
			</div>
		</div>
	</div>
}

templ SubstationCard() {
	<div class="card mb-3">
		<div class="card-header">
			<div class="card-title">New substation</div>
		</div>
		<div class="card-body">
			<form id="substation-form">
				<div class="mb-3">
					<label class="form-label" for="name-input">Name</label>
					<input type="text" class="form-control" id="name-input" name="name" required/>
				</div>
				<div class="mb-3">
					<label class="form-label" for="region-input">Region</label>
					<input type="text" class="form-control" id="region-input" name="region" required/>
				</div>
				<div class="mb-3">
					<label class="form-label" for="long-input">Longitude</label>
					<input type="number" step="0.01" class="form-control" id="long-input" name="x" required/>
				</div>
				<div class="mb-3">
					<label class="form-label" for="lat-input">Latitude</label>
					<input type="number" step="0.01" class="form-control" id="lat-input" name="y" required/>
				</div>
				<button id="submit-substation" class="btn btn-primary w-100" type="submit">Submit</button>
			</form>
			<hr/>
			<label class="form-label" for="substation-file">Upload many from file</label>
			<input type="file" id="substation-file" class="form-control" accept=".jsonl,.ndjson"/>
			<div class="form-hint">
				One JSON record per line, e.g.
				<code>{`{"name":"Substation C","region":"NO2","x":10.5,"y":60.1}`}</code>
			</div>
		</div>
	</div>
}

templ PageScript() {
	<script>
		const endPointMap = new Map([
			["line-form", "/upload/lines"],
			["line-file", "/upload/lines"],
			["substation-form", "/upload/substations"],
			["substation-file", "/upload/substations"],
		]);
		const numberFields = ["length", "voltage", "x", "y"];

		function setStatus(text) {
			document.getElementById("status-bar").textContent = text;
		}
		async function post(endpoint, jsonl, successText) {
			try {
				const url = new URL(endpoint, location.href);
				url.searchParams.set("commit", "true");
				const modelId = document.getElementById("model-selection")?.value;
				if (modelId) url.searchParams.set("modelId", modelId);
				const resp = await fetch(url, {
					method: "POST",
					headers: { "Content-Type": "application/x-ndjson" },
					body: jsonl,
				});
				const text = await resp.text();
				if (resp.ok) {
					setStatus(successText);
				} else {
					setStatus(text);
				}
			} catch (e) {
				console.log(e);
				setStatus(String(e));
			}
		}
		function submitFormAsJsonl(formId) {
			const form = document.getElementById(formId);
			const formData = new FormData(form);
			const data = Object.fromEntries(formData.entries());
			for (const key of numberFields) {
				if (key in data) {
					data[key] = Number(data[key]);
				}
			}
			post(endPointMap.get(formId), JSON.stringify(data) + "\n", "Successfully created item");
		}
		async function submitFileAsJsonl(fileId) {
			const input = document.getElementById(fileId);
			const file = input.files?.[0];
			if (!file) return;
			const text = await file.text();
			// A blank line fails to unmarshal server-side, so drop it. Line
			// numbers in error messages therefore refer to the filtered records.
			const records = text.split("\n").filter((line) => line.trim() !== "");
			input.value = "";
			post(
				endPointMap.get(fileId),
				records.join("\n") + "\n",
				`Successfully created ${records.length} items from ${file.name}`,
			);
		}
		document.getElementById("line-form").addEventListener("submit", (e) => {
			e.preventDefault();
			submitFormAsJsonl("line-form");
		});

		document
			.getElementById("substation-form")
			.addEventListener("submit", (e) => {
				e.preventDefault();
				submitFormAsJsonl("substation-form");
			});

		document.getElementById("line-file").addEventListener("change", () => {
			submitFileAsJsonl("line-file");
		});

		document
			.getElementById("substation-file")
			.addEventListener("change", () => {
				submitFileAsJsonl("substation-file");
			});
	</script>
}
