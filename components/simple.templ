package components

templ SimplePage() {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>TripleWorks Simple Editor</title>
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/@tabler/core@1.6.1/dist/css/tabler.min.css"
		/>
		<script src="https://unpkg.com/htmx.org@2.0.7"></script>
	</head>
	<body>
		<div class="container-xl mt3">
			<h1 class="h2 mb-3">Simple object creator</h1>
			<div id="status-bar">Idle</div>
			<div class="mb-3">
				<label class="form-label" for="model-selection">Model</label>
				<div hx-get="/models" hx-trigger="load"></div>
			</div>
			@LineCard()
			@SubstationCard()
		</div>
		@PageScript()
	</body>
}

templ LineCard() {
	<div class="card mb-3">
		<div class="card-header">
			<div class="card-title">New Line</div>
		</div>
		<div class="card-body">
			<form id="line-form">
				<div class="mb-3">
					<label class="form-label" for="from-input">From substation</label>
					<input type="text" class="form-control" id="from-input" name="from" required/>
				</div>
				<div class="mb-3">
					<label class="form-label" for="to-input">To substation</label>
					<input type="text" class="form-control" id="to-input" name="to" required/>
				</div>
				<div class="mb-3">
					<label class="form-label" for="length-input">Length (km)</label>
					<input type="number" class="form-control" id="length-input" name="length" required/>
				</div>
				<div class="mb-3">
					<label class="form-label" for="voltage-input">Voltage (kV)</label>
					<input type="number" class="form-control" id="voltage-input" name="voltage" required/>
				</div>
				<button id="submit-line" class="btn btn-primary w-100" type="submit">Submit</button>
			</form>
		</div>
	</div>
}

templ SubstationCard() {
	<div class="card mb-3">
		<div class="card-header">
			<div class="card-title">New substation</div>
		</div>
		<div class="card-body">
			<form id="substation-form">
				<div class="mb-3">
					<label class="form-label" for="name-input">Name</label>
					<input type="text" class="form-control" id="name-input" name="name" required/>
				</div>
				<div class="mb-3">
					<label class="form-label" for="region-input">Region</label>
					<input type="text" class="form-control" id="region-input" name="region" required/>
				</div>
				<div class="mb-3">
					<label class="form-label" for="long-input">Longitude</label>
					<input type="number" step="0.01" class="form-control" id="long-input" name="x" required/>
				</div>
				<div class="mb-3">
					<label class="form-label" for="lat-input">Latitude</label>
					<input type="number" step="0.01" class="form-control" id="lat-input" name="y" required/>
				</div>
				<button id="submit-substation" class="btn btn-primary w-100" type="submit">Submit</button>
			</form>
		</div>
	</div>
}

templ PageScript() {
	<script>
		const endPointMap = new Map([
			["line-form", "/upload/lines"],
			["substation-form", "/upload/substations"],
		]);
		const numberFields = ["length", "voltage", "x", "y"];

		function setStatus(text) {
			document.getElementById("status-bar").textContent = text;
		}
		async function submitFormAsJsonl(formId) {
			const form = document.getElementById(formId);
			const formData = new FormData(form);
			const data = Object.fromEntries(formData.entries());
			for (const key of numberFields) {
				if (key in data) {
					data[key] = Number(data[key]);
				}
			}
			const jsonPayload = JSON.stringify(data) + "\n";
			try {
				const url = new URL(endPointMap.get(formId), location.href);
				url.searchParams.set("commit", "true");
				const modelId = document.getElementById("model-selection")?.value;
				if (modelId) url.searchParams.set("modelId", modelId);
				const resp = await fetch(url, {
					method: "POST",
					headers: { "Content-Type": "application/x-ndjson" },
					body: jsonPayload,
				});
				const text = await resp.text();
				if (resp.ok) {
					setStatus("Successfully created item");
				} else {
					setStatus(text);
				}
			} catch (e) {
				console.log(e);
				setStatus(String(e));
			}
		}
		document.getElementById("line-form").addEventListener("submit", (e) => {
			e.preventDefault();
			submitFormAsJsonl("line-form");
		});

		document
			.getElementById("substation-form")
			.addEventListener("submit", (e) => {
				e.preventDefault();
				submitFormAsJsonl("substation-form");
			});
	</script>
}
